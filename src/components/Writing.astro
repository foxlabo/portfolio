---
import { profile } from '../data/profile';
import { getArticles } from '../data/articles';
import Icon from './Icon.astro';

const articles = await getArticles();
const note = profile.links.find((l) => l.href.includes('note.com'));
---

<section class="section" id="writing" aria-labelledby="writing-title">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">03</span>
      <h2 class="section-title" id="writing-title">Writing</h2>
      {
        note && (
          <a class="more" href={note.href} target="_blank" rel="noopener noreferrer">
            note で読む <Icon name="arrow-up-right" size={14} />
          </a>
        )
      }
    </div>
    <p class="lead reveal">Claude Code・Codex をはじめとする生成 AI 開発の実践知を、note で継続的に発信しています。</p>

    <ul class="articles">
      {
        articles.map((a) => (
          <li class="reveal">
            <a class="card glow article" href={a.url} target="_blank" rel="noopener noreferrer">
              <time class="label" datetime={a.date}>
                {a.date.replaceAll('-', '.')}
              </time>
              <h3>{a.title}</h3>
              <span class="source">
                note <Icon name="arrow-up-right" size={13} />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .section-head {
    margin-bottom: 16px;
  }

  .more {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    color: var(--text-2);
    white-space: nowrap;
    transition: color 0.2s;
  }

  .more:hover {
    color: var(--accent-2);
  }

  .lead {
    margin-bottom: 32px;
    max-width: 640px;
    color: var(--text-2);
  }

  .articles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .articles li {
    display: flex;
  }

  .article {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
    padding: 22px 24px;
    transition: border-color 0.2s;
  }

  .article:hover {
    border-color: var(--line-strong);
  }

  h3 {
    font-size: 16px;
    font-weight: 560;
    line-height: 1.6;
    letter-spacing: -0.005em;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .source {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-3);
    transition: color 0.2s;
  }

  .article:hover .source {
    color: var(--accent-2);
  }

  @media (max-width: 900px) {
    .articles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 580px) {
    .articles {
      grid-template-columns: 1fr;
    }
  }
</style>
