---
import Layout from '../layouts/Layout.astro';
import { profile } from '../data/profile';
---

<Layout title={`404 — ${profile.name}`} description="ページが見つかりませんでした。">
  <main id="main" class="nf">
    <div class="glow-bg" aria-hidden="true"></div>
    <p class="cmd"><span>➜</span> ~ <span data-path>cd /page</span></p>
    <p class="err">zsh: no such file or directory</p>
    <h1 class="gradient-text">404</h1>
    <p class="msg">お探しのページは見つかりませんでした。</p>
    <a class="btn btn-ghost" href="/">トップへ戻る</a>
  </main>
</Layout>

<style>
  .nf {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 32px 16px;
    text-align: center;
    overflow: hidden;
  }

  .glow-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(ellipse 50% 40% at 50% 45%, rgba(139, 123, 255, 0.28), transparent 70%);
  }

  .cmd,
  .err {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-3);
  }

  .cmd span:first-child {
    color: var(--ok);
  }

  .err {
    color: #ff7b72;
  }

  h1 {
    margin-top: 12px;
    font-size: clamp(96px, 20vw, 200px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.06em;
  }

  .msg {
    margin-bottom: 24px;
    color: var(--text-2);
  }
</style>

<script>
  const el = document.querySelector('[data-path]');
  if (el) el.textContent = `cd ${location.pathname}`;
</script>
